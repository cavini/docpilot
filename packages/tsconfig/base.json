{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "DocPilot base",
  "compilerOptions": {
    "target": "ES2023",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    /*
     * Incremental builds, with the build info kept next to the output rather
     * than at the package root.
     *
     * The default puts `.tsbuildinfo` beside the tsconfig, where deleting
     * `dist` leaves it behind - and the next build reads it, decides nothing
     * has changed, and emits nothing. A silent no-op that produces a package
     * with no `dist` and exit code 0, which then fails in whatever imports
     * it. Keeping the two together means they can only be deleted as a pair.
     */
    "incremental": true,
    "tsBuildInfoFile": "${configDir}/dist/.tsbuildinfo",
    "pretty": true
  }
}
