# Use the Node version in .nvmrc, so the hook does not depend on whichever
# version happens to be active in the committing shell.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh" --no-use
  nvm use --silent >/dev/null 2>&1 || true
fi

pnpm lint-staged
