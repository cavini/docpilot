# Copy to .env and adjust. Every variable below is read by the application and
# validated at startup, so an unknown or malformed value stops the process with
# a readable message instead of failing later on a request.
#
# The defaults are the local Docker Compose setup, so copying this file
# unchanged gives a working development environment.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# API transport
# ---------------------------------------------------------------------------
API_PORT=3001
# Comma separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Data stores (required)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://docpilot:docpilot@localhost:5432/docpilot
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Ingestion worker
# ---------------------------------------------------------------------------
# inline   runs the queue processors inside the API process (development, and
#          the cheap single-service deploy)
# separate expects a second process started with `pnpm dev:worker`
# off      disables processing entirely, for tests that only need the HTTP API
WORKER_MODE=inline
WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Document storage
# ---------------------------------------------------------------------------
# s3 targets any S3 compatible endpoint; local writes to disk instead.
STORAGE_DRIVER=s3
S3_BUCKET=docpilot-documents
S3_REGION=us-east-1
# Points at the local emulator. Leave empty to target real AWS.
S3_ENDPOINT=http://localhost:4566
# Emulators need path style addressing; real AWS does not.
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCAL_STORAGE_DIR=./uploads

# ---------------------------------------------------------------------------
# Language model provider
# ---------------------------------------------------------------------------
# mock uses deterministic in-process models, so the test suite needs no keys
# and costs nothing. Switch to openai or anthropic to run the real thing, and
# set the matching key below.
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model that answers questions. Defaults to the most capable; a cheaper one
# cuts cost substantially for this workload. See docs/costs.md.
CHAT_MODEL=claude-opus-5

# Embeddings are configured separately because Anthropic publishes no
# first-party embeddings API, so the two choices are independent.
# `mock` needs no key and is what the test suite uses.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
# Must match the database column; changing it is a migration plus a
# re-embedding of the whole corpus.
EMBEDDING_DIMENSIONS=1536

# ---------------------------------------------------------------------------
# Chunking and upload limits
# ---------------------------------------------------------------------------
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
MAX_UPLOAD_MB=20
# How many documents the corpus may hold. MAX_UPLOAD_MB covers one enormous
# file; this covers a thousand small ones, which costs the same in embeddings
# and storage and is the easier of the two to do by accident. 0 means no
# limit, which is right for a local corpus and wrong for a public URL.
MAX_DOCUMENTS=0

# ---------------------------------------------------------------------------
# Feature flags (defaults; rows in the feature_flags table override these)
# ---------------------------------------------------------------------------
FF_RERANK=false
FF_GRAPHQL=true
FF_AGENT_TOOLS=true
# How many model calls one agent turn may make. A model that keeps calling
# tools costs money on every step and would otherwise run until the request
# times out.
AGENT_MAX_STEPS=6
FF_PUBLIC_UPLOADS=true

# ---------------------------------------------------------------------------
# Demo protection
# ---------------------------------------------------------------------------
# Empty leaves the API open, which is the local default. Set it on a public
# deployment to require an x-demo-key header on every request.
#
# One shared secret, not an identity. It will be pasted into messages and
# forwarded, so treat it as a way to keep crawlers out rather than as a
# boundary. What protects the provider balance is DAILY_BUDGET_USD below.
DEMO_API_KEY=

# A ceiling on what a UTC day of model calls may cost, in US dollars, read
# from the llm_usage ledger. This is the measure that actually protects a
# hosted demo: a request-count limit has no dollars in it, because one agent
# turn can be six model calls and a cached search can be none.
#
# Past the ceiling, answering falls back to the mock provider and ingestion is
# refused - a document embedded by the mock would sit in the corpus returning
# confident nonsense for every future search.
#
# 0 means no ceiling, which is the local default where every call is mocked.
DAILY_BUDGET_USD=0

# ---------------------------------------------------------------------------
# Tracing (off by default; needs a Datadog agent reachable at DD_AGENT_HOST)
# ---------------------------------------------------------------------------
DD_TRACE_ENABLED=false
DD_SERVICE=docpilot-api
DD_ENV=local
# Empty means "the version in package.json", which is almost always what you
# want. Set it on a deployment to report the build actually running, such as a
# container image tag. A hardcoded version here is wrong from the first release
# onwards and nothing tells you.
DD_VERSION=
DD_AGENT_HOST=localhost

# ---------------------------------------------------------------------------
# Web application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Must match MAX_UPLOAD_MB, which the API defaults to 20. The browser refuses
# an oversized file before sending it; the API refuses it again, because a
# client check is a convenience and never a guarantee. Two variables because
# only NEXT_PUBLIC_ ones reach the browser.
NEXT_PUBLIC_MAX_UPLOAD_MB=20
