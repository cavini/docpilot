# Copy to .env and adjust. Every variable below is read by the application and
# validated at startup, so an unknown or malformed value stops the process with
# a readable message instead of failing later on a request.
#
# The defaults are the local Docker Compose setup, so copying this file
# unchanged gives a working development environment.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# API transport
# ---------------------------------------------------------------------------
API_PORT=3001
# Comma separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Data stores (required)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://docpilot:docpilot@localhost:5432/docpilot
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Ingestion worker
# ---------------------------------------------------------------------------
# inline   runs the queue processors inside the API process (development, and
#          the cheap single-service deploy)
# separate expects a second process started with `pnpm dev:worker`
# off      disables processing entirely, for tests that only need the HTTP API
WORKER_MODE=inline
WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Document storage
# ---------------------------------------------------------------------------
# s3 targets any S3 compatible endpoint; local writes to disk instead.
STORAGE_DRIVER=s3
S3_BUCKET=docpilot-documents
S3_REGION=us-east-1
# Points at the local emulator. Leave empty to target real AWS.
S3_ENDPOINT=http://localhost:4566
# Emulators need path style addressing; real AWS does not.
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCAL_STORAGE_DIR=./uploads

# ---------------------------------------------------------------------------
# Language model provider
# ---------------------------------------------------------------------------
# mock uses deterministic in-process models, so the test suite needs no keys
# and costs nothing. Switch to openai or anthropic to run the real thing, and
# set the matching key below.
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model that answers questions. Defaults to the most capable; a cheaper one
# cuts cost substantially for this workload. See docs/costs.md.
CHAT_MODEL=claude-opus-5

# Embeddings are configured separately because Anthropic publishes no
# first-party embeddings API, so the two choices are independent.
# `mock` needs no key and is what the test suite uses.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
# Must match the database column; changing it is a migration plus a
# re-embedding of the whole corpus.
EMBEDDING_DIMENSIONS=1536

# ---------------------------------------------------------------------------
# Chunking and upload limits
# ---------------------------------------------------------------------------
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
MAX_UPLOAD_MB=20

# ---------------------------------------------------------------------------
# Feature flags (defaults; rows in the feature_flags table override these)
# ---------------------------------------------------------------------------
FF_RERANK=false
FF_GRAPHQL=true
FF_AGENT_TOOLS=true
FF_PUBLIC_UPLOADS=true

# ---------------------------------------------------------------------------
# Demo protection
# ---------------------------------------------------------------------------
# Empty leaves the API open, which is the local default. Set it on a public
# deployment to require an x-api-key header.
DEMO_API_KEY=

# ---------------------------------------------------------------------------
# Tracing (off by default; needs a Datadog agent reachable at DD_AGENT_HOST)
# ---------------------------------------------------------------------------
DD_TRACE_ENABLED=false
DD_SERVICE=docpilot-api
DD_ENV=local
DD_VERSION=0.0.0
DD_AGENT_HOST=localhost

# ---------------------------------------------------------------------------
# Web application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_DEFAULT_LOCALE=en
