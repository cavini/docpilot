{
  "name": "@docpilot/api",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "openapi:export": "nest build && node dist/export-openapi.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.integration.config.mjs",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.e2e.config.mjs",
    "test:contract": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.contract.config.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "nest build && node dist/scripts/seed.js",
    "record-embeddings": "nest build && node dist/scripts/record-embeddings.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.93",
    "@ai-sdk/openai": "4.0.106",
    "@aws-sdk/client-s3": "3.1161.0",
    "@docpilot/shared": "workspace:*",
    "@docpilot/testing": "workspace:*",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/event-emitter": "12.0.0",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/platform-socket.io": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "12.3.2",
    "ai": "7.0.159",
    "bullmq": "6.5.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dd-trace": "6.23.0",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "js-tiktoken": "1.0.21",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "unpdf": "2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@docpilot/tsconfig": "workspace:*",
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.20",
    "@swc/jest": "0.2.39",
    "@testcontainers/localstack": "12.2.1",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/express": "5.0.5",
    "@types/jest": "30.0.0",
    "@types/multer": "2.0.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.15.6",
    "@types/supertest": "7.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-kit": "0.31.11",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3"
  }
}
