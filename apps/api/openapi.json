{
  "openapi": "3.0.0",
  "paths": {
    "/feature-flags": {
      "get": {
        "operationId": "FeatureFlagsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Every flag with its current value"
          }
        },
        "summary": "List feature flags and their current values",
        "tags": [
          "feature-flags"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Every dependency is usable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "At least one dependency is down",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Health of the API and its dependencies",
        "tags": [
          "health"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The process is running"
          }
        },
        "summary": "Liveness only, with no dependency probes",
        "tags": [
          "health"
        ]
      }
    },
    "/documents": {
      "post": {
        "operationId": "DocumentsController_upload",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "These bytes were already uploaded; the existing document is returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponseDto"
                }
              }
            }
          },
          "201": {
            "description": "The document was accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponseDto"
                }
              }
            }
          }
        },
        "summary": "Upload a PDF, Markdown or plain text document",
        "tags": [
          "documents"
        ]
      },
      "get": {
        "operationId": "DocumentsController_list",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentPageDto"
                }
              }
            }
          }
        },
        "summary": "List documents, newest first",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{id}": {
      "get": {
        "operationId": "DocumentsController_get",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponseDto"
                }
              }
            }
          }
        },
        "summary": "Read one document and its ingestion status",
        "tags": [
          "documents"
        ]
      },
      "delete": {
        "operationId": "DocumentsController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The document is gone"
          }
        },
        "summary": "Delete a document and everything derived from it",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{id}/retry": {
      "post": {
        "operationId": "DocumentsController_retry",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponseDto"
                }
              }
            }
          }
        },
        "summary": "Reprocess a document that failed",
        "tags": [
          "documents"
        ]
      }
    }
  },
  "info": {
    "title": "DocPilot API",
    "description": "Answers questions about uploaded documents with citations back to the\nexact source chunk, and acts on them through tools.\n\nResponses that fail carry the shape `{ error: { code, message, requestId } }`.\nBranch on `code`, which is stable, rather than on `message`.",
    "version": "0.0.0",
    "contact": {},
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness and dependency status"
    },
    {
      "name": "feature-flags",
      "description": "Which capabilities are enabled"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local development"
    }
  ],
  "components": {
    "securitySchemes": {
      "demoApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "DependencyHealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "description": "Whether the dependency answered.",
            "enum": [
              "ok",
              "degraded",
              "down"
            ],
            "type": "string",
            "example": "ok"
          },
          "latencyMs": {
            "type": "number",
            "description": "Round trip time of the probe, absent when the probe did not complete.",
            "example": 3
          },
          "error": {
            "type": "string",
            "description": "Why the probe failed. Never contains credentials.",
            "example": "connection refused"
          }
        },
        "required": [
          "status"
        ]
      },
      "HealthDependenciesResponse": {
        "type": "object",
        "properties": {
          "database": {
            "$ref": "#/components/schemas/DependencyHealthResponse"
          },
          "redis": {
            "$ref": "#/components/schemas/DependencyHealthResponse"
          },
          "storage": {
            "$ref": "#/components/schemas/DependencyHealthResponse"
          }
        },
        "required": [
          "database",
          "redis",
          "storage"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "description": "Worst status across every dependency.",
            "enum": [
              "ok",
              "degraded",
              "down"
            ],
            "type": "string",
            "example": "ok"
          },
          "version": {
            "type": "string",
            "description": "Application version.",
            "example": "0.1.0"
          },
          "uptimeSeconds": {
            "type": "number",
            "description": "Seconds since the process started.",
            "example": 1284
          },
          "checkedAt": {
            "type": "string",
            "description": "When the probes ran.",
            "example": "2026-10-30T12:00:00.000Z"
          },
          "dependencies": {
            "$ref": "#/components/schemas/HealthDependenciesResponse"
          }
        },
        "required": [
          "status",
          "version",
          "uptimeSeconds",
          "checkedAt",
          "dependencies"
        ]
      },
      "DocumentResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "description": "Display name, the filename without its extension.",
            "example": "billing-api"
          },
          "sourceFilename": {
            "type": "string",
            "description": "The name the file was uploaded under.",
            "example": "billing-api.pdf"
          },
          "mimeType": {
            "type": "string",
            "example": "application/pdf"
          },
          "sizeBytes": {
            "type": "number",
            "example": 418233
          },
          "status": {
            "type": "string",
            "description": "Where the document is in the pipeline.",
            "enum": [
              "queued",
              "parsing",
              "chunking",
              "embedding",
              "ready",
              "failed"
            ],
            "example": "ready"
          },
          "progress": {
            "type": "number",
            "description": "How far through ingestion, from 0 to 100.",
            "example": 100
          },
          "language": {
            "type": "string",
            "nullable": true,
            "description": "Detected language, which decides the text-search stemmer.",
            "enum": [
              "english",
              "portuguese"
            ]
          },
          "error": {
            "type": "string",
            "nullable": true,
            "description": "Why ingestion failed, when it did.",
            "example": null
          },
          "pageCount": {
            "type": "number",
            "nullable": true,
            "description": "Pages, for formats that have them.",
            "example": 12
          },
          "chunkCount": {
            "type": "number",
            "description": "Retrievable passages stored for this document.",
            "example": 48
          },
          "createdAt": {
            "type": "string",
            "example": "2026-10-30T22:14:03.118Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-10-30T22:14:09.441Z"
          }
        },
        "required": [
          "id",
          "title",
          "sourceFilename",
          "mimeType",
          "sizeBytes",
          "status",
          "progress",
          "chunkCount",
          "createdAt",
          "updatedAt"
        ]
      },
      "DocumentPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentResponseDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Pass back as `cursor` to fetch the next page. Null when this is the last.",
            "example": "2026-10-30T22:14:03.118Z"
          }
        },
        "required": [
          "items"
        ]
      }
    }
  }
}
