{
  "openapi": "3.0.0",
  "paths": {
    "/feature-flags": {
      "get": {
        "operationId": "FeatureFlagsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Every flag with its current value"
          }
        },
        "summary": "List feature flags and their current values",
        "tags": [
          "feature-flags"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Every dependency is usable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "At least one dependency is down",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Health of the API and its dependencies",
        "tags": [
          "health"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The process is running"
          }
        },
        "summary": "Liveness only, with no dependency probes",
        "tags": [
          "health"
        ]
      }
    },
    "/documents": {
      "post": {
        "operationId": "DocumentsController_upload",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "These bytes were already uploaded; the existing document is returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponseDto"
                }
              }
            }
          },
          "201": {
            "description": "The document was accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponseDto"
                }
              }
            }
          }
        },
        "summary": "Upload a PDF, Markdown or plain text document",
        "tags": [
          "documents"
        ]
      },
      "get": {
        "operationId": "DocumentsController_list",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentPageDto"
                }
              }
            }
          }
        },
        "summary": "List documents, newest first",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{id}": {
      "get": {
        "operationId": "DocumentsController_get",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponseDto"
                }
              }
            }
          }
        },
        "summary": "Read one document and its ingestion status",
        "tags": [
          "documents"
        ]
      },
      "delete": {
        "operationId": "DocumentsController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The document is gone"
          }
        },
        "summary": "Delete a document and everything derived from it",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{id}/retry": {
      "post": {
        "operationId": "DocumentsController_retry",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponseDto"
                }
              }
            }
          }
        },
        "summary": "Reprocess a document that failed",
        "tags": [
          "documents"
        ]
      }
    },
    "/search": {
      "post": {
        "operationId": "SearchController_search",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked passages",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponseDto"
                }
              }
            }
          }
        },
        "summary": "Search the corpus with hybrid retrieval",
        "tags": [
          "search"
        ]
      }
    },
    "/ask": {
      "post": {
        "operationId": "AskController_answer",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The answer and its citations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponseDto"
                }
              }
            }
          }
        },
        "summary": "Answer a question from the documents, with citations",
        "tags": [
          "ask"
        ]
      }
    }
  },
  "info": {
    "title": "DocPilot API",
    "description": "Answers questions about uploaded documents with citations back to the\nexact source chunk, and acts on them through tools.\n\nResponses that fail carry the shape `{ error: { code, message, requestId } }`.\nBranch on `code`, which is stable, rather than on `message`.",
    "version": "0.0.0",
    "contact": {},
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness and dependency status"
    },
    {
      "name": "feature-flags",
      "description": "Which capabilities are enabled"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local development"
    }
  ],
  "components": {
    "securitySchemes": {
      "demoApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "DependencyHealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "description": "Whether the dependency answered.",
            "enum": [
              "ok",
              "degraded",
              "down"
            ],
            "type": "string",
            "example": "ok"
          },
          "latencyMs": {
            "type": "number",
            "description": "Round trip time of the probe, absent when the probe did not complete.",
            "example": 3
          },
          "error": {
            "type": "string",
            "description": "Why the probe failed. Never contains credentials.",
            "example": "connection refused"
          }
        },
        "required": [
          "status"
        ]
      },
      "HealthDependenciesResponse": {
        "type": "object",
        "properties": {
          "database": {
            "$ref": "#/components/schemas/DependencyHealthResponse"
          },
          "redis": {
            "$ref": "#/components/schemas/DependencyHealthResponse"
          },
          "storage": {
            "$ref": "#/components/schemas/DependencyHealthResponse"
          }
        },
        "required": [
          "database",
          "redis",
          "storage"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "description": "Worst status across every dependency.",
            "enum": [
              "ok",
              "degraded",
              "down"
            ],
            "type": "string",
            "example": "ok"
          },
          "version": {
            "type": "string",
            "description": "Application version.",
            "example": "0.1.0"
          },
          "uptimeSeconds": {
            "type": "number",
            "description": "Seconds since the process started.",
            "example": 1284
          },
          "checkedAt": {
            "type": "string",
            "description": "When the probes ran.",
            "example": "2026-10-30T12:00:00.000Z"
          },
          "dependencies": {
            "$ref": "#/components/schemas/HealthDependenciesResponse"
          }
        },
        "required": [
          "status",
          "version",
          "uptimeSeconds",
          "checkedAt",
          "dependencies"
        ]
      },
      "DocumentResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "description": "Display name, the filename without its extension.",
            "example": "billing-api"
          },
          "sourceFilename": {
            "type": "string",
            "description": "The name the file was uploaded under.",
            "example": "billing-api.pdf"
          },
          "mimeType": {
            "type": "string",
            "example": "application/pdf"
          },
          "sizeBytes": {
            "type": "number",
            "example": 418233
          },
          "status": {
            "type": "string",
            "description": "Where the document is in the pipeline.",
            "enum": [
              "queued",
              "parsing",
              "chunking",
              "embedding",
              "ready",
              "failed"
            ],
            "example": "ready"
          },
          "progress": {
            "type": "number",
            "description": "How far through ingestion, from 0 to 100.",
            "example": 100
          },
          "language": {
            "type": "string",
            "nullable": true,
            "description": "Detected language, which decides the text-search stemmer.",
            "enum": [
              "english",
              "portuguese"
            ]
          },
          "error": {
            "type": "string",
            "nullable": true,
            "description": "Why ingestion failed, when it did.",
            "example": null
          },
          "pageCount": {
            "type": "number",
            "nullable": true,
            "description": "Pages, for formats that have them.",
            "example": 12
          },
          "chunkCount": {
            "type": "number",
            "description": "Retrievable passages stored for this document.",
            "example": 48
          },
          "createdAt": {
            "type": "string",
            "example": "2026-10-30T22:14:03.118Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-10-30T22:14:09.441Z"
          }
        },
        "required": [
          "id",
          "title",
          "sourceFilename",
          "mimeType",
          "sizeBytes",
          "status",
          "progress",
          "chunkCount",
          "createdAt",
          "updatedAt"
        ]
      },
      "DocumentPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentResponseDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Pass back as `cursor` to fetch the next page. Null when this is the last.",
            "example": "2026-10-30T22:14:03.118Z"
          }
        },
        "required": [
          "items"
        ]
      },
      "SearchRequestDto": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "What to search for.",
            "example": "how do I authenticate?"
          },
          "topK": {
            "type": "number",
            "description": "How many results to return. Defaults to `RETRIEVAL_TOP_K`.",
            "minimum": 1,
            "maximum": 50,
            "example": 8
          },
          "documentIds": {
            "description": "Restrict the search to these documents. Omit to search everything.",
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "query"
        ]
      },
      "SearchResultDto": {
        "type": "object",
        "properties": {
          "chunkId": {
            "type": "string",
            "format": "uuid"
          },
          "documentId": {
            "type": "string",
            "format": "uuid"
          },
          "documentTitle": {
            "type": "string",
            "example": "lumen-api"
          },
          "content": {
            "type": "string",
            "description": "The passage itself."
          },
          "headingPath": {
            "type": "string",
            "nullable": true,
            "description": "Where in the document this passage sits.",
            "example": "Lumen API > Authentication"
          },
          "pageStart": {
            "type": "number",
            "nullable": true,
            "example": 3
          },
          "pageEnd": {
            "type": "number",
            "nullable": true,
            "example": 3
          },
          "score": {
            "type": "number",
            "description": "Fused relevance score. Comparable within one search only — it is a sum of\nreciprocal ranks, not a probability.",
            "example": 0.0323
          },
          "vectorRank": {
            "type": "number",
            "nullable": true,
            "description": "Rank in the vector search, or null if that search did not find it.",
            "example": 1
          },
          "keywordRank": {
            "type": "number",
            "nullable": true,
            "description": "Rank in the keyword search, or null if that search did not find it.",
            "example": 3
          }
        },
        "required": [
          "chunkId",
          "documentId",
          "documentTitle",
          "content",
          "score"
        ]
      },
      "SearchResponseDto": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchResultDto"
            }
          },
          "tookMs": {
            "type": "number",
            "description": "How long the search took, in milliseconds.",
            "example": 41
          },
          "cached": {
            "type": "boolean",
            "description": "Whether the query embedding came from cache rather than the provider.",
            "example": false
          }
        },
        "required": [
          "results",
          "tookMs",
          "cached"
        ]
      },
      "AskRequestDto": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "description": "The question to answer from the corpus.",
            "example": "How do I authenticate?"
          },
          "topK": {
            "type": "number",
            "description": "How many passages to retrieve. Defaults to `RETRIEVAL_TOP_K`.",
            "minimum": 1,
            "maximum": 20,
            "example": 8
          },
          "documentIds": {
            "description": "Restrict the answer to these documents.",
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "question"
        ]
      },
      "CitationDto": {
        "type": "object",
        "properties": {
          "n": {
            "type": "number",
            "description": "The number as it appears in the answer text.",
            "example": 1
          },
          "chunkId": {
            "type": "string",
            "format": "uuid"
          },
          "documentId": {
            "type": "string",
            "format": "uuid"
          },
          "documentTitle": {
            "type": "string",
            "example": "lumen-api"
          },
          "headingPath": {
            "type": "string",
            "nullable": true,
            "example": "Lumen API > Authentication"
          },
          "pageStart": {
            "type": "number",
            "nullable": true,
            "example": 3
          },
          "pageEnd": {
            "type": "number",
            "nullable": true,
            "example": 3
          },
          "snippet": {
            "type": "string",
            "description": "The passage itself, for display beside the answer."
          }
        },
        "required": [
          "n",
          "chunkId",
          "documentId",
          "documentTitle",
          "snippet"
        ]
      },
      "AnswerUsageDto": {
        "type": "object",
        "properties": {
          "inputTokens": {
            "type": "number",
            "example": 912
          },
          "outputTokens": {
            "type": "number",
            "example": 64
          },
          "costUsd": {
            "type": "number",
            "example": 0.001256
          }
        },
        "required": [
          "inputTokens",
          "outputTokens",
          "costUsd"
        ]
      },
      "AskResponseDto": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string",
            "description": "The answer, with citation markers like `[1]` placed after the claims they\nsupport. A marker the model invented has been removed.",
            "example": "Call POST /auth/token with your client id and secret to obtain a bearer token [1]."
          },
          "citations": {
            "description": "The passages the answer drew on, in the order they are first cited.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CitationDto"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/AnswerUsageDto"
          }
        },
        "required": [
          "answer",
          "citations",
          "usage"
        ]
      }
    }
  }
}
