  "info": {
    "title": "DocPilot API",
    "description": "Answers questions about uploaded documents with citations back to the\nexact source chunk, and acts on them through tools.\n\nResponses that fail carry the shape `{ error: { code, message, requestId } }`.\nBranch on `code`, which is stable, rather than on `message`.",
    "version": "0.2.0",
    "contact": {},
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness and dependency status"
    },
    {
      "name": "feature-flags",
      "description": "Which capabilities are enabled"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local development"
    }
  ],
  "components": {
    "securitySchemes": {
      "demoApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "DependencyHealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "description": "Whether the dependency answered.",
            "enum": [
              "ok",
              "degraded",
              "down"
            ],
            "type": "string",
            "example": "ok"
          },
          "latencyMs": {
            "type": "number",
            "description": "Round trip time of the probe, absent when the probe did not complete.",
            "example": 3
          },
          "error": {
            "type": "string",
            "description": "Why the probe failed. Never contains credentials.",
            "example": "connection refused"
          }
        },
        "required": [
          "status"
        ]
      },
      "HealthDependenciesResponse": {
        "type": "object",
        "properties": {
          "database": {
            "$ref": "#/components/schemas/DependencyHealthResponse"
          },
          "redis": {
            "$ref": "#/components/schemas/DependencyHealthResponse"
          },
          "storage": {
            "$ref": "#/components/schemas/DependencyHealthResponse"
          }
        },
        "required": [
          "database",
          "redis",
          "storage"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "description": "Worst status across every dependency.",
            "enum": [
              "ok",
              "degraded",
              "down"
            ],
            "type": "string",
            "example": "ok"
          },
          "version": {
            "type": "string",
            "description": "Application version.",
            "example": "0.2.0"
          },
          "uptimeSeconds": {
            "type": "number",
            "description": "Seconds since the process started.",
            "example": 1284
          },
          "checkedAt": {
            "type": "string",
            "description": "When the probes ran.",
            "example": "2026-10-30T12:00:00.000Z"
          },
          "dependencies": {
            "$ref": "#/components/schemas/HealthDependenciesResponse"
          }
        },
        "required": [
          "status",
          "version",
          "uptimeSeconds",
          "checkedAt",
          "dependencies"
        ]
      },
      "ChatRequestDto": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "description": "The question to answer.",
            "example": "How do I authenticate?"
          },
          "conversationId": {
            "type": "string",
            "description": "Conversation to continue. Omit to start one.",
            "format": "uuid"
          },
          "topK": {
            "type": "number",
            "description": "How many passages to retrieve. Defaults to `RETRIEVAL_TOP_K`.",
            "minimum": 1,
            "maximum": 20,
            "example": 8
          },
          "documentIds": {
            "description": "Restrict retrieval to these documents. Omit to search everything.",
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "messages": {
            "type": "array",
            "description": "The turn so far, when resuming one that paused for approval.",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "required": [
          "question"
        ]
      },
      "ErrorBodyDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable identifier for the failure. Branch on this rather\nthan on the message, which may be reworded.",
            "example": "not_found"
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation. Never contains credentials.",
            "example": "document 7f3a was not found"
          },
          "requestId": {
            "type": "string",
            "description": "Identifier of the request that failed. Quote it in a bug report: it\nappears on every log line for the request.",
            "example": "6f6cf7c5-d7c3-4281-8c89-c67912abade4"
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "description": "Extra context, present only when it helps the caller act."
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyDto"
          }
        },
        "required": [
          "error"
        ]
      },
      "AskRequestDto": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "description": "The question to answer from the corpus.",
            "example": "How do I authenticate?"
          },
          "topK": {
            "type": "number",
            "description": "How many passages to retrieve. Defaults to `RETRIEVAL_TOP_K`.",
            "minimum": 1,
            "maximum": 20,
            "example": 8
          },
          "documentIds": {
            "description": "Restrict the answer to these documents.",
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "question"
        ]
      },
      "CitationDto": {
        "type": "object",
        "properties": {
          "n": {
            "type": "number",
            "description": "The number as it appears in the answer text.",
            "example": 1
          },
          "chunkId": {
            "type": "string",
            "format": "uuid"
          },
          "documentId": {
            "type": "string",
            "format": "uuid"
          },
          "documentTitle": {
            "type": "string",
            "example": "lumen-api"
          },
          "headingPath": {
            "type": "string",
            "nullable": true,
            "example": "Lumen API > Authentication"
          },
