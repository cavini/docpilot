{
  "name": "docpilot",
  "version": "0.0.0",
  "private": true,
  "description": "Answers questions about your documentation with cited sources, and acts on it through tools and MCP",
  "license": "MIT",
  "author": "Arthur Cavini",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=10.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d --wait",
    "infra:logs": "docker compose logs -f",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules/.cache .turbo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@docpilot/eslint-config": "workspace:*",
    "@docpilot/tsconfig": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
